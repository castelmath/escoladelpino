local function setModeTrial(active)
    config.Enabled = active
    
    if active then
        mainToggle.Text = "🟢 MODO TRIAL ATIVADO"
        mainToggle.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        mainToggle.BackgroundTransparency = 0.1
        isAiming = aimbotToggle.Text == "ON"
        killAuraEnabled = killToggle.Text == "ON"
        
        if killAuraEnabled and not killAuraThread then
            killAuraThread = task.spawn(killAura)
        end
        
        if isAiming and not aimbotThread then
            aimbotThread = task.spawn(aimbotLoop)
        end
        
        statusBar.Text = "🎯 MODO TRIAL ATIVADO - Buscando alvos..."
        statusBar.TextColor3 = Color3.fromRGB(100, 255, 100)
    else
        mainToggle.Text = "🔴 MODO TRIAL DESATIVADO"
        mainToggle.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        mainToggle.BackgroundTransparency = 0.2
        isAiming = false
        killAuraEnabled = false
        currentTarget = nil
        
        if killAuraThread then
            task.cancel(killAuraThread)
            killAuraThread = nil
        end
        
        if aimbotThread then
            task.cancel(aimbotThread)
            aimbotThread = nil
        end
        
        statusBar.Text = "🎯 Modo Trial desativado"
        statusBar.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
end

