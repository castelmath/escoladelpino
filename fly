-- ============================================
-- FUNÇÕES DE UTILIDADE
-- ============================================

local function getCharacter()
    return player.Character
end

local function isAlive(char)
    if not char then return false end
    local humanoid = char:FindFirstChild("Humanoid")
    return humanoid and humanoid.Health > 0 and char.Parent ~= nil
end

local function getPlayers()
    local enemies = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local char = plr.Character
            if isAlive(char) then
                -- Verificar se é inimigo (time check)
                if config.TeamCheck then
                    local plrTeam = plr.Team
                    local myTeam = player.Team
                    if plrTeam and myTeam and plrTeam == myTeam then
                        continue
                    end
                end
                table.insert(enemies, plr)
            end
        end
    end
    return enemies
end

local function getPart(char, partName)
    if not char then return nil end
    local part = char:FindFirstChild(partName)
    if part and part:IsA("BasePart") then
        return part
    end
    -- Fallback para HumanoidRootPart
    return char:FindFirstChild("HumanoidRootPart")
end

local function getClosestPart(char, position)
    local parts = {"Head", "HumanoidRootPart", "Torso", "UpperTorso", "LowerTorso"}
    local closest = nil
    local closestDist = math.huge
    
    for _, partName in ipairs(parts) do
        local part = char:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            local dist = (part.Position - position).Magnitude
            if dist < closestDist then
                closestDist = dist
                closest = part
            end
        end
    end
    
    return closest or char:FindFirstChild("HumanoidRootPart")
end

local function isVisible(targetPart)
    if not targetPart then return false end
    if not config.WallCheck then return true end
    
    local origin = camera.CFrame.Position
    local direction = (targetPart.Position - origin).Unit
    local ray = Ray.new(origin, direction * (origin - targetPart.Position).Magnitude)
    local hit, position = Workspace:FindPartOnRay(ray, player.Character, false, true)
    
    if not hit then return true end
    local hitParent = hit.Parent
    if hitParent and (hitParent:IsA("BasePart") or hitParent:IsA("MeshPart")) then
        local humanoid = hitParent:FindFirstChild("Humanoid")
        if humanoid then return true end
    end
    return false
end

local function getTargets()
    local targets = {}
    local myPos = camera.CFrame.Position
    
    for _, plr in ipairs(getPlayers()) do
        local char = plr.Character
        if char then
            local part = getClosestPart(char, myPos)
            if part then
                local dist = (part.Position - myPos).Magnitude
                if dist <= config.Range then
                    if isVisible(part) then
                        table.insert(targets, {
                            Player = plr,
                            Part = part,
                            Distance = dist,
                            Health = (char:FindFirstChild("Humanoid") and char.Humanoid.Health) or 100
                        })
                    end
                end
            end
        end
    end
    
    return targets
end

local function selectTarget(targets)
    if #targets == 0 then return nil end
    
    if config.TargetMode == "Closest" then
        table.sort(targets, function(a, b) return a.Distance < b.Distance end)
        return targets[1]
    elseif config.TargetMode == "LowestHealth" then
        table.sort(targets, function(a, b) return a.Health < b.Health end)
        return targets[1]
    elseif config.TargetMode == "Random" then
        return targets[math.random(1, #targets)]
    end
    
    return targets[1]
end

-- ============================================
-- AIMBOT
-- ============================================

local function aimAt(target)
    if not target or not target.Part then return end
    
    local targetPos = target.Part.Position
    local targetCFrame = CFrame.new(camera.CFrame.Position, targetPos)
    
    -- Suavização
    if config.Smoothness > 1 then
        local currentCF = camera.CFrame
        local newCF = CFrame.new(currentCF.Position, targetPos)
        local tweenInfo = TweenInfo.new(0.05 * (config.Smoothness / 10), Enum.EasingStyle.Linear)
        
        local tween = TweenService:Create(camera, tweenInfo, {
            CFrame = newCF
        })
        tween:Play()
    else
        camera.CFrame = CFrame.new(camera.CFrame.Position, targetPos)
    end
end

local function aimbotLoop()
    while config.Enabled do
        if isAiming then
            local targets = getTargets()
            local target = selectTarget(targets)
            
            if target then
                currentTarget = target
                aimAt(target)
            else
                currentTarget = nil
            end
        end
        task.wait(0.05)
    end
end

-- ============================================
-- KILL AURA
-- ============================================

local function killPlayer(target)
    if not target or not target.Character then return end
    
    local char = target.Character
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    
    -- Tentar métodos diferentes para matar
    local methods = {
        function()
            -- Método 1: Setar saúde para 0
            humanoid.Health = 0
        end,
        function()
            -- Método 2: BreakJoints
            char:BreakJoints()
        end,
        function()
            -- Método 3: Remover humanoid
            humanoid:Destroy()
        end
    }
    
    for _, method in ipairs(methods) do
        pcall(method)
        if not isAlive(char) then break end
    end
end

local function killAura()
    while killAuraEnabled do
        local myPos = camera.CFrame.Position
        
        for _, plr in ipairs(getPlayers()) do
            local char = plr.Character
            if char then
                local part = getClosestPart(char, myPos)
                if part then
                    local dist = (part.Position - myPos).Magnitude
                    if dist <= config.KillAuraRange then
                        if isVisible(part) then
                            killPlayer(plr)
                            task.wait(config.KillAuraDelay)
                        end
                    end
                end
            end
        end
        
        task.wait(0.1)
    end
end

