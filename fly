local function updateFlightStatus(active)
    config.isFlying = active
    
    local statusColor = active and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 50, 50)
    local statusTextColor = active and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
    local statusTextStr = active and "🟢 VOO ATIVADO" or "🔴 VOO DESATIVADO"
    local statusSubStr = active and "Voando livremente!" or "Pressione o botão para ativar"
    local btnText = active and "🛬 DESATIVAR VOO" or "🚀 ATIVAR VOO"
    local btnColor = active and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(80, 50, 200)
    
    -- Atualizar UI
    statusIndicator.BackgroundColor3 = statusColor
    statusIndicator.BackgroundTransparency = 0.2
    pulse.BackgroundColor3 = statusColor
    statusText.Text = statusTextStr
    statusText.TextColor3 = statusTextColor
    statusSub.Text = statusSubStr
    toggleBtn.Text = btnText
    toggleBtn.BackgroundColor3 = btnColor
    toggleBtn.BackgroundTransparency = 0.15
    
    -- Animações
    local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local pulseTween = TweenService:Create(pulse, tweenInfo, {
        Size = active and UDim2.new(2, 20, 2, 20) or UDim2.new(1, 10, 1, 10),
        BackgroundTransparency = active and 0.3 or 0.7
    })
    pulseTween:Play()
    
    local btnTween = TweenService:Create(toggleBtn, tweenInfo, {
        BackgroundTransparency = active and 0.25 or 0.15
    })
    btnTween:Play()
end

local function startFlight()
    if not getCharacter() then
        warn("Não foi possível obter o personagem!")
        return
    end
    
    -- Verificar se está em um veículo
    if isPlayerInVehicle() then
        warn("Você está em um veículo! Saia do veículo para voar.")
        return
    end
    
    -- Criar BodyVelocity
    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(100000, 100000, 100000)
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.Parent = rootPart
    
    -- Desabilitar gravidade
    humanoid.PlatformStand = true
    
    updateFlightStatus(true)
end

local function stopFlight()
    if bodyVelocity then
        bodyVelocity:Destroy()
        bodyVelocity = nil
    end
    
    if humanoid then
        humanoid.PlatformStand = false
    end
    
    updateFlightStatus(false)
end

local function updateFlight()
    if not config.isFlying or not bodyVelocity or not character or not rootPart then
        return
    end
    
    -- Verificar se o personagem ainda existe
    if not character.Parent then
        stopFlight()
        return
    end
    
    -- Verificar se está em um veículo
    if isPlayerInVehicle() then
        stopFlight()
        warn("Voo desativado: você entrou em um veículo!")
        return
    end
    
    local moveDirection = Vector3.new(0, 0, 0)
    local camera = workspace.CurrentCamera
    if not camera then return end
    
    local cameraCFrame = camera.CFrame
    
    -- Calcular direção
    local forward = cameraCFrame.LookVector
    local right = cameraCFrame.RightVector
    
    -- Manter apenas componentes horizontais
    forward = Vector3.new(forward.X, 0, forward.Z).Unit
    right = Vector3.new(right.X, 0, right.Z).Unit
    
    if keys.W then
        moveDirection = moveDirection + forward
    end
    if keys.S then
        moveDirection = moveDirection - forward
    end
    if keys.A then
        moveDirection = moveDirection - right
    end
    if keys.D then
        moveDirection = moveDirection + right
    end
    
    -- Normalizar direção horizontal
    if moveDirection.Magnitude > 0 then
        moveDirection = moveDirection.Unit * config.FlightSpeed
    end
    
    -- Adicionar vertical
    if keys.Space then
        moveDirection = moveDirection + Vector3.new(0, config.FlightSpeed, 0)
    end
    if keys.Shift then
        moveDirection = moveDirection - Vector3.new(0, config.FlightSpeed, 0)
    end
    
    bodyVelocity.Velocity = moveDirection
end

