local function safeWaitForChild(parent, name, timeout)
    timeout = timeout or 5
    local start = tick()
    while tick() - start < timeout do
        local child = parent:FindFirstChild(name)
        if child then return child end
        task.wait(0.1)
    end
    return nil
end

local function getCharacter()
    character = player.Character or player.CharacterAdded:Wait()
    if not character then return false end
    
    humanoid = safeWaitForChild(character, "Humanoid")
    rootPart = safeWaitForChild(character, "HumanoidRootPart")
    
    if not humanoid or not rootPart then
        return false
    end
    
    return true
end

local function isPlayerInVehicle()
    if not character then return false end
    local seat = character:FindFirstChild("SeatPart") or character:FindFirstChildOfClass("VehicleSeat")
    return seat ~= nil
end

